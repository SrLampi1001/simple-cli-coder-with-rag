# LLM provider API keys. The key for `DEFAULT_PROVIDER` is required; the
# other two may be left empty. Override per-provider model and base URL
# below if you self-host or want a different default.
NVIDIA_API_KEY=
MISTRAL_API_KEY=
MINIMAX_API_KEY=

# Which provider's adapter to use at startup. One of: nvidia, mistral, minimax.
DEFAULT_PROVIDER=nvidia

# Per-provider default model. Override here if you want a different model
# from the built-in defaults. The defaults below were verified to respond
# to chat completion calls on the project's test account during the DO-03
# smoke test; the previous defaults (`meta/llama-3.1-70b-instruct` and
# `mistral-large-latest`) returned HTTP 410 / HTTP 403 from the providers.
# Other models that are known to work for chat on the test account:
#   NVIDIA:  openai/gpt-oss-20b, nvidia/nemotron-3-super-120b-a12b
#   Mistral: codestral-latest, ministral-8b-latest
NVIDIA_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-code-latest
MINIMAX_MODEL=MiniMax-M3

# Optional per-provider base URL. Leave empty to use the built-in default
# endpoint (NVIDIA NIM cloud, Mistral La Plateforme, MiniMax Anthropic-compat).
NVIDIA_BASE_URL=
MISTRAL_BASE_URL=
MINIMAX_BASE_URL=

# Model used by the REPL chat path (DO-03). Leave empty to fall back to
# the active provider's per-provider default above (e.g. NVIDIA_MODEL).
# Set this if you want a different model for chat than the compaction model.
CHAT_MODEL=

# Chunking Strategy used by `/learn` (DO-05).
#   fixed    — FixedSizeChunker (default; sliding window, predictable sizes).
#   semantic — SemanticChunker (one chunk per logical record).
CHUNKER_STRATEGY=fixed

# Vector store Strategy used by `/learn` (DO-07).
#   sqlite_vec  — SqliteVecStore (default; persistent, requires a Python
#                 build with sqlite3 extension loading enabled).
#   brute_force  — NumpyBruteForceStore (fallback; in-memory only, no
#                 persistence). The composition root also falls back to
#                 brute_force if the sqlite-vec init fails on this machine.
# Set to brute_force on systems with the SQLITE_OMIT_LOAD_EXTENSION flag.
VECTOR_STORE=sqlite_vec

# On-disk path for the sqlite-vec database. Leave empty to use the
# platform-default location (Linux: ~/.local/share/simple-cli-coder-with-rag/db.sqlite).
# Override when running tests, CI, or containerised installs.
DB_PATH=

# Upper bound on a single retrieval call, in seconds (DO-08). The retriever
# chain wraps the base retriever in a TimeoutRetriever that returns "no
# memories" if a search exceeds this deadline — so a slow retrieval never
# blocks the user's prompt. Default 1.5s is plenty for a few-hundred-row
# cosine lookup; tighten for latency-sensitive integrations.
RETRIEVAL_TIMEOUT_SECONDS=

# Recall pipeline tuning (DO-09). Top-k caps how many chunks the retriever
# returns for a single user prompt — small enough to keep the LLM context
# window manageable, large enough that "obvious" hits land inside the slice.
# Default 3 matches the OBJECTIVES latency tip ("top-k 3 or so").
RECALL_TOP_K=

# Minimum cosine similarity for a recalled chunk to be injected into the
# chat prompt (DO-09). Chunks below the threshold are dropped from the
# coordinator's output — keeps weakly-related noise out of the LLM context.
# Default 0.5 is a conservative floor for bge-small-en-v1.5 cosine scores.
RECALL_SIMILARITY_THRESHOLD=

# Trivial-gate bounds (DO-09). A prompt is "trivial" (and the recall path
# short-circuits) when it satisfies BOTH bounds inclusively:
#   len(prompt) <= TRIVIAL_GATE_MAX_CHARS  AND  words <= TRIVIAL_GATE_MAX_WORDS
# Defaults 20 chars and 4 words match the OBJECTIVES latency tip.
TRIVIAL_GATE_MAX_CHARS=
TRIVIAL_GATE_MAX_WORDS=

# File-editor sandbox root (DO-10). Every read/write/edit the agent does
# is confined to this directory; paths that escape (via .., an absolute
# path, or a symlink) are rejected with PathNotAllowed. Leave empty to
# default to the current working directory at startup. Override here to
# scope the agent's edits to a sub-project.
EDITOR_ROOT=

# Upper bound on tool-use rounds per chat turn (DO-10). One round is one
# complete_with_tools call followed by zero-or-more tool executions. The
# default 1 keeps the chat loop bounded — a runaway agent cannot loop
# indefinitely calling tools. Increase when the agent needs more turns
# (e.g. mutating a file and re-reading it).
EDITOR_MAX_TOOL_ROUNDS=